#!/usr/bin/env python3
'''
Agent to run perfsonar lookup webservice.
Writes the defaults for interfaces and hosts
'''

import argparse
import logging
import logging.config
from configparser import ConfigParser
import sys

##########
# Parse command-line options
# Instantiate the parser
parser = argparse.ArgumentParser(description='lookupservice_registration_agent')
parser.add_argument('--config', dest='CONFIG_FILE', action='store', required=False, default='/etc/perfsonar/pslookup/pslookup-registration.conf', help='configuration file')
parser.add_argument('--verbose', dest='DEBUGFLAG', action='store_true', help='Add additional debug output')

args = parser.parse_args()

##########
# Create logger
if not args.LOGGER_CONF:

    output_level = logging.INFO
    if args.DEBUGFLAG:
        output_level = logging.DEBUG
    
    logging.basicConfig(level=output_level)
    logger = logging.getLogger('pslookup')

else:
    logging.config.fileConfig(args.LOGGER_CONF)
    logger = logging.getLogger("pslookup")


#Get the paths of config and default files
#Read the config file
def get_configs():
    conf = ConfigParser()

    try:
        conf.read(args.CONFIG_FILE)
    except Exception as e:
        logger.error('Error reading the registration config: {}'.format(e))
        sys.exit('Error reading the registration config: {}'.format(e))

    try:
        default_host_path = conf.get('record_data', 'host_overwite_conf_path')
    except Exception as e:
        logger.info('Error getting the default host path: {}'.format(e))
        logger.info('Default the default host path to: {}'.format('/etc/perfsonar/pslookup/pslookup-record-conf/host.json'))
        default_host_path = '/etc/perfsonar/pslookup/pslookup-record-conf/host.json'

    try:
        default_interface_path = conf.get('record_data', 'interface_overwite_conf_path')
    except Exception as e:
        logger.info('Error getting the default host path: {}'.format(e))
        logger.info('Default the default host path to: {}'.format('/etc/perfsonar/pslookup/pslookup-record-conf/interfaces.json'))
        default_interface_path = '/etc/perfsonar/pslookup/pslookup-record-conf/interfaces.json'
    
    return default_host_path, default_interface_path

